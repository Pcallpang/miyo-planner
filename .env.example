# ── 구글 OAuth 2.0 (Google Cloud Console에서 발급) ─────────────────
# https://console.cloud.google.com → API 및 서비스 → 사용자 인증 정보
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth 클라이언트에 등록한 리디렉션 URI와 동일해야 합니다.
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# ── Gemini API (Google AI Studio에서 발급) ─────────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 사용할 모델 (기본값: gemini-flash-lite-latest — 무료 등급에서 동작).
# 유료(후불) 프로젝트 키라면 gemini-flash-latest 등 상위 모델도 사용 가능합니다.
GEMINI_MODEL=gemini-flash-lite-latest

# ── 나이스(NEIS) 교육정보 개방 포털 — 급식·학사일정 ────────────────
# https://open.neis.go.kr → 로그인 후 인증키 신청
# 비워두면 급식·학사일정이 5건까지만 조회됩니다 — 나이스가 인증키 없는 요청에는
# pSize·pIndex를 무시하고 첫 5건만 돌려주기 때문입니다. 발급은 무료입니다.
NEIS_API_KEY=

# ── 서버 설정 ─────────────────────────────────────────────────────
PORT=3001

# ── Supabase(Postgres) — 사용자별 데이터 저장 ──────────────────────
# 프로젝트 → Settings → Database → Connection string 에서 복사합니다.
# 서버리스 배포(Vercel)에서는 "Transaction pooler"(포트 6543)를 사용하세요.
# 대시보드가 주는 문자열을 그대로 쓰면 됩니다 — 사용자명이 postgres.<프로젝트ref>
# 형태여야 하며, 이를 그냥 postgres로 바꾸면 인증이 거부됩니다.
# [YOUR-PASSWORD] 부분을 실제 DB 비밀번호로 바꿔야 합니다.
DATABASE_URL=
# 저장되는 OAuth 토큰 암호화 키(길고 랜덤한 값). 지정하지 않으면 server/data/.enckey에
# 로컬 키가 자동 생성됩니다. 배포 시에는 반드시 고정된 값을 설정하세요.
# TOKEN_ENC_KEY=

# ── 배포(공개 접속) 관련 ──────────────────────────────────────────
# 배포 시에만 필요. 세션 서명 키(길고 랜덤한 값). 배포 시 설정 권장.
# SESSION_SECRET=
# 공개 주소. 배포 시 반드시 고정 도메인을 지정하세요 — OAuth 리디렉션 주소와
# 세션 쿠키의 Secure 플래그가 이 값에서 결정됩니다.
# PUBLIC_URL=https://your-app.vercel.app
# 로그인 완료 후 돌아갈 프론트엔드 주소
CLIENT_URL=http://localhost:5173

# ── 자리배치 앱 연동 ──────────────────────────────────────────────
# 사이드바 "스마트 자리배치"가 여는 주소. 비우면 아래 기본값을 씁니다.
# SEATING_APP_URL=https://sn-aseating.vercel.app
