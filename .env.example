# ── 구글 OAuth 2.0 (Google Cloud Console에서 발급) ─────────────────
# https://console.cloud.google.com → API 및 서비스 → 사용자 인증 정보
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth 클라이언트에 등록한 리디렉션 URI와 동일해야 합니다.
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# ── Gemini API (Google AI Studio에서 발급) ─────────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 사용할 모델 (기본값: gemini-flash-lite-latest — 무료 등급에서 동작).
# 유료(후불) 프로젝트 키라면 gemini-flash-latest 등 상위 모델도 사용 가능합니다.
GEMINI_MODEL=gemini-flash-lite-latest

# ── 서버 설정 ─────────────────────────────────────────────────────
PORT=3001
# 로그인 완료 후 돌아갈 프론트엔드 주소 (로컬 개발용)
# (선택) 저장되는 OAuth 토큰 암호화 키. 지정하지 않으면 server/data/.enckey에
# 로컬 키가 자동 생성됩니다. 여러 기기에서 토큰 파일을 옮겨 쓸 때만 고정하세요.
# TOKEN_ENC_KEY=

# ── 배포(공개 접속) 관련 ──────────────────────────────────────────
# 배포 시에만 필요. 로컬 개발에서는 비워두면 비밀번호 없이 열립니다.
# 앱 접속 비밀번호(설정하면 로그인 화면이 켜짐). 배포 시 반드시 설정하세요.
# APP_PASSWORD=
# 세션 서명 키(길고 랜덤한 값). 배포 시 설정 권장.
# SESSION_SECRET=
# 공개 주소. Render 등에서는 자동 감지되므로 보통 비워둡니다.
# PUBLIC_URL=https://your-app.onrender.com
# (선택) 재배포에도 구글 연동을 유지하려면 refresh_token을 여기에 고정.
# GOOGLE_REFRESH_TOKEN=
# 로그인 완료 후 돌아갈 프론트엔드 주소
CLIENT_URL=http://localhost:5173
